{
  "name": "monachessimo",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first chess trainer that builds practice from your own games.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:lessons": "LESSON_DEPTH=18 vitest run tests/unit/lessons.node.test.ts",
    "build:offline": "npm run typecheck && vite build --mode offline"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@wllama/wllama": "3.13.0",
    "chessground": "^9.2.1",
    "chessops": "^0.15.1",
    "idb": "^8.0.4",
    "preact": "^11.2.0",
    "stockfish": "^19.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
